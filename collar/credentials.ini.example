; Copy this file to credentials.ini and set your values.
; credentials.ini is gitignored — never commit the real file.
;
; LORA_SYNC_WORD must match lora_sync_word in basestation/esphome/secrets.yaml.
; 0x12 is the RadioLib default for private networks (decimal: 18).

[credentials]
build_flags = -DLORA_SYNC_WORD=0x12
